    },
    {
      "type": "text",
      "id": "example-text",
      "x": 733,
      "y": 292,
      "width": 194,
      "height": 118,
      "text": "示例: LPush/RPush\nM = UINT64_MAX / 2\n\nKey:   \"items\"\nValue: [kList][0][v=789]\n       [size=3][head=M-1]\n       [tail=M+2]\n\n\"items\"|789|M-1 -> \"0\"\n\"items\"|789|M   -> \"a\"\n\"items\"|789|M+1 -> \"b\"",
      "originalText": "示例: LPush/RPush\nM = UINT64_MAX / 2\n\nKey:   \"items\"\nValue: [kList][0][v=789]\n       [size=3][head=M-1]\n       [tail=M+2]\n\n\"items\"|789|M-1 -> \"0\"\n\"items\"|789|M   -> \"a\"\n\"items\"|789|M+1 -> \"b\"",
      "fontSize": 11,
