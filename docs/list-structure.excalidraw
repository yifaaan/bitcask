      "isDeleted": false,
      "groupIds": ["flow"],
      "boundElements": null,
      "link": null,
      "locked": false,
      "roundness": { "type": 3 }
    },
    {
      "type": "text",
      "id": "pop-flow-text",
      "x": 335,
      "y": 724,
      "width": 245,
      "height": 150,
      "text": "LPop / RPop\n\n1. LoadMetadata(key, kList)\n2. LPop: index = head++\n   RPop: index = --tail\n3. DB.Get(data_key) 取回元素\n4. Delete(data_key)，size--\n5. size=0 删除 metadata\n   否则 Put(updated metadata)",
      "originalText": "LPop / RPop\n\n1. LoadMetadata(key, kList)\n2. LPop: index = head++\n   RPop: index = --tail\n3. DB.Get(data_key) 取回元素\n4. Delete(data_key)，size--\n5. size=0 删除 metadata\n   否则 Put(updated metadata)",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 9049,
