    {
      "type": "text",
      "id": "dkey-desc",
      "x": 30,
      "y": 382,
      "width": 650,
      "height": 42,
      "text": "Data Key layout = [key][version][index]；Value 保存元素原始字节。\nversion 隔离 Delete 后重建的旧元素，避免旧 data key 被新 List 读到。",
      "originalText": "Data Key layout = [key][version][index]；Value 保存元素原始字节。\nversion 隔离 Delete 后重建的旧元素，避免旧 data key 被新 List 读到。",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 9027,
      "version": 1,
      "versionNonce": 9027,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "containerId": null,
      "lineHeight": 1.25
    },
    {
      "type": "rectangle",
      "id": "example-bg",
      "x": 720,
      "y": 278,
      "width": 220,
      "height": 148,
      "strokeColor": "#1e293b",
      "backgroundColor": "#1e293b",
      "fillStyle": "solid",
      "strokeWidth": 1,
