    {
      "type": "text",
      "id": "push-flow-text",
      "x": 45,
      "y": 724,
      "width": 230,
      "height": 150,
      "text": "LPush / RPush\n\n1. Load metadata；不存在则创建\n2. LPush: index = --head\n   RPush: index = tail++\n3. size++\n4. WriteBatch:\n   Put(key, metadata)\n   Put(data_key, value)\n5. Commit",
      "originalText": "LPush / RPush\n\n1. Load metadata；不存在则创建\n2. LPush: index = --head\n   RPush: index = tail++\n3. size++\n4. WriteBatch:\n   Put(key, metadata)\n   Put(data_key, value)\n5. Commit",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 9047,
      "version": 1,
      "versionNonce": 9047,
      "isDeleted": false,
      "groupIds": ["flow"],
      "boundElements": null,
      "link": null,
      "locked": false,
      "containerId": null,
      "lineHeight": 1.25
    },
    {
      "type": "rectangle",
      "id": "pop-flow-bg",
      "x": 320,
      "y": 710,
      "width": 275,
      "height": 180,
      "strokeColor": "#b91c1c",
      "backgroundColor": "#fecaca",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 9048,
      "version": 1,
